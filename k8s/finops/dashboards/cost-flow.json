          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(x_team,'platform') AS business, COALESCE(x_application,'gix') AS application, COALESCE(service_category,'Other') AS category, SUM(effective_cost)::double precision AS usd FROM focus_cost_records WHERE $__timeFilter(time) GROUP BY 1, 2, 3 ORDER BY 4 DESC"
