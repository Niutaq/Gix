          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 hour', time) AS time, COALESCE(service_category,'Other') AS metric, SUM(estimated_cost_usd)::double precision AS value FROM provider_unit_costs WHERE $__timeFilter(time) GROUP BY 1, 2 ORDER BY 1"
