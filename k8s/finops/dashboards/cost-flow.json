          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 hour', time) AS time, source AS metric, SUM(effective_cost)::double precision AS value FROM focus_cost_records WHERE $__timeFilter(time) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
