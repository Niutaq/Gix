    {
      "id": 3,
      "title": "FOCUS by source",
      "type": "table",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cost" },
            "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 5 }]
          }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT source, COALESCE(x_application,'gix') AS application, COALESCE(service_category,'Other') AS category, SUM(effective_cost)::double precision AS cost FROM focus_cost_records WHERE $__timeFilter(time) GROUP BY 1,2,3 ORDER BY 4 DESC"
        }
      ]
    },
    {
      "id": 4,
      "title": "FOCUS effective cost over time",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescale" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "lineWidth": 1, "spanNulls": false }
