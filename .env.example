# Development-only defaults. Do not reuse these values outside local compose.
POSTGRES_USER=gixuser
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=gix_rates
DATABASE_URL=postgres://gixuser:change-me-local-only@localhost:5433/gix_rates?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# NetSecOps (NIS2 access control): when set, POST /discover + DELETE /cantors require header X-Gix-API-Key.
# Leave empty for open local-dev; set a long random value before exposing the API.
# GIX_API_KEY=
# Optional CORS allowlist (comma-separated). Empty = * (local only).
# GIX_CORS_ORIGINS=http://127.0.0.1:8080

# Offline LLM (default). No cloud API key required.
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Legacy cloud LLM only if LLM_PROVIDER=gemini or auto (fallback).
# GEMINI_API_KEY=

# Map tiles default to OpenStreetMap (no key). Carto requires a key since Sep 2026.
# MAP_TILE_PROVIDER=carto
# CARTO_API_KEY=          # https://carto.com/basemaps/apikey/
# MAP_TILE_PROVIDER=maptiler
# MAPTILER_API_KEY=       # https://www.maptiler.com/

# Optional. Force fake coords for local testing (ignored unless GIX_USE_DEV_COORDS=1).
# GIX_USE_DEV_COORDS=1
# GIX_DEV_COORDS=54.35,18.65
